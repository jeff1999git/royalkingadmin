# Database
MONGODB_URI=mongodb+srv://username:password@cluster.example.mongodb.net/royal-king-water-supply

# NextAuth
NEXTAUTH_SECRET=replace-with-a-long-random-secret
NEXTAUTH_URL=http://localhost:3000

# Cloudinary
CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME

# Admin login
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-password

# Google Drive (optional) — enables "Save to Google Drive" on the Deliveries page.
# A public OAuth client ID, not a secret. Setup steps are in README.md.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
